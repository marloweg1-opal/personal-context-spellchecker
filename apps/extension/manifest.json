{
  "manifest_version": 3,
  "name": "Personal Contextual Spellchecker",
  "version": "0.1.0",
  "description": "Local-first personal spellchecking for supported editable fields.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
